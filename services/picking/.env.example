# .env for the Picking service
APP_NAME="POS Picking Service"
DEBUG=true

SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database — same shared MySQL instance as every other service (see
# libs/pos_common/README.md for why). Picking owns pos_itempick only.
DB_HOST=host.docker.internal
DB_USER=db_username
DB_PASSWORD=db_password
DB_NAME=db_name
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Service-to-service auth for calls to Ordering's /internal/orders/* — must
# match Ordering's (currently: the monolith's) INTERNAL_SERVICE_TOKEN exactly.
INTERNAL_SERVICE_TOKEN=change-me-internal

# Points at the temporary /internal/orders router on the still-running
# monolith until Ordering is extracted (Step 4 of the migration), then
# repoints at the real Ordering service — only this URL changes, no code.
ORDERING_SERVICE_URL=http://core:8000
