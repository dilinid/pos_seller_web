# .env
APP_NAME="POS Seller Web API"
# POS Seller Web API - Development Environment Configuration
DEBUG=true

# Flask / JWT Configuration
SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Item resource uploads (images/videos referenced by pos_item_resources.resource_path,
# inserted by the external POS application). Leave empty to use the local
# backend/uploads/ folder (dev fixture). In production, point this at wherever the
# POS application's uploads root actually lives (local path or reachable UNC/network path).
UPLOADS_DIR=

# Database Configuration
DB_HOST=this_should_be_db_host
DB_USER=db_username
DB_PASSWORD=db_password
DB_NAME=db_name
REPORT_DB_NAME=report_db_name
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false