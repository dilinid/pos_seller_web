# .env for the Ordering service
APP_NAME="POS Ordering Service"
DEBUG=true

SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database — same shared MySQL instance as every other service (see
# libs/pos_common/README.md for why). Ordering owns pos_ordhed/pos_orddtl/
# pos_invhed/pos_invdtl/pos_invpay.
DB_HOST=host.docker.internal
DB_USER=db_username
DB_PASSWORD=db_password
DB_NAME=db_name
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

# Service-to-service auth for the /internal/orders/* endpoints Picking calls.
# Must match Picking's INTERNAL_SERVICE_TOKEN exactly.
INTERNAL_SERVICE_TOKEN=change-me-internal
